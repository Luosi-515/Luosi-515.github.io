<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>𝓒𝓾𝓲｜海外零食代購・團購</title>
<style>
:root{--bg:#fbf7f4;--card:#fff;--text:#4a4041;--muted:#9c8d8f;--accent:#c48a94;--btn:#e0b0b7;--line:#f2e6e4;--on:#fff;color-scheme:light;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,"PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;line-height:1.6}
header{padding:26px 16px 12px;text-align:center}
h1{margin:0;font-size:24px;color:var(--accent)}
header p{margin:6px 0 0;color:var(--muted);font-size:14px}
main{max-width:720px;margin:0 auto;padding:0 14px 120px}
#search{width:100%;font:inherit;padding:11px 14px;border:1px solid var(--line);border-radius:12px;background:var(--card);color:var(--text)}
#chips{display:flex;gap:8px;overflow-x:auto;padding:10px 0}
.chip{white-space:nowrap;background:var(--card);color:var(--text);border:1px solid var(--line);padding:6px 14px;border-radius:99px;font-weight:500}
.chip.on{background:var(--btn);color:var(--on);border-color:transparent}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:4px}
.pic{font-size:44px;text-align:center}
.name{font-weight:600}
.desc{font-size:13px;color:var(--muted);flex:1}
.price{color:var(--accent);font-weight:700}
button{font:inherit;cursor:pointer;border:0;border-radius:99px;padding:9px 16px;background:var(--btn);color:var(--on);font-weight:600}
button.ghost{background:#fff;color:var(--accent);border:1px solid #ebd2d5}
#bar{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--line);padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));display:flex;justify-content:space-between;align-items:center}
#sheet{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:5}
#panel{position:absolute;left:0;right:0;bottom:0;max-height:92%;overflow:auto;background:var(--bg);border-radius:18px 18px 0 0;padding:18px 16px calc(24px + env(safe-area-inset-bottom,0px))}
.row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--line);gap:8px}
.qty button{padding:2px 10px}
input,textarea{width:100%;font:inherit;padding:10px;margin:4px 0 10px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--text)}
input[type=radio]{width:auto;margin:0 6px 0 0}
label{font-size:14px;color:var(--muted)}
.pay label{display:block;color:var(--text);padding:6px 0}
pre{white-space:pre-wrap;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px;font:inherit;font-size:14px}
.note{font-size:13px;color:var(--muted)}
#adminlink{text-align:center;margin-top:24px}
</style>
</head>
<body>
<header><h1>🍬 𝓒𝓾𝓲｜海外零食代購・團購</h1><p>精選海外零食・直接下單最安心</p></header>
<main>
<input id="search" type="search" placeholder="🔍 搜尋商品…" oninput="renderGrid()">
<div id="chips"></div>
<div class="grid" id="grid"></div>
<div id="adminlink"></div>
</main>
<div id="bar"><div>共 <b id="cnt">0</b> 件・NT$ <b id="tot">0</b></div><button onclick="openSheet()">查看購物車</button></div>
<div id="sheet"><div id="panel"></div></div>

<!-- 商品清單：每行一個商品，格式「分類|商品名稱|價格|簡介|表情符號|圖片或影片網址(可不填)」 -->
<script type="text/plain" id="data">日本|抹茶巧克力|180|濃郁抹茶，80g|🍫
韓國|蜂蜜奶油洋芋片|150|甜鹹交織，60g|🥔
泰國|芒果乾|120|無添加糖，100g|🥭
美國|彩虹軟糖|99|繽紛水果口味，200g|🍭
日本|草莓夾心餅|160|酥脆香甜，12入|🍓
韓國|海苔脆片|130|海苔脆脆，40g|🍙</script>

<script>
var CONTACT_LINE_URL="https://lin.ee/xHCstu4";
var CONTACT_EMAIL="b0975210480@gmail.com";
var PRODUCTS=[],cart={},curCat="全部";
function $(i){return document.getElementById(i)}
function fmt(n){return n.toLocaleString()}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function parse(txt){
  return txt.split("\n").map(function(l){return l.trim()}).filter(Boolean).map(function(l,i){
    var a=l.split("|");return {id:i,cat:(a[0]||"其他").trim(),name:(a[1]||"").trim(),price:Number(a[2])||0,desc:(a[3]||"").trim(),emoji:(a[4]||"🍬").trim(),video:(a[5]||"").trim()}
  }).filter(function(p){return p.name});
}
function renderChips(){
  var cats=["全部"];PRODUCTS.forEach(function(p){if(cats.indexOf(p.cat)<0)cats.push(p.cat)});
  $("chips").innerHTML=cats.map(function(c){return '<button class="chip'+(c===curCat?' on':'')+'" data-c="'+esc(c)+'">'+esc(c)+'</button>'}).join("");
  Array.prototype.forEach.call($("chips").children,function(b){b.onclick=function(){curCat=b.getAttribute("data-c");renderChips();renderGrid()}});
}
function renderGrid(){
  var q=$("search").value.trim().toLowerCase();
  var list=PRODUCTS.filter(function(p){return (curCat==="全部"||p.cat===curCat)&&(!q||(p.name+p.desc+p.cat).toLowerCase().indexOf(q)>=0)});
  $("grid").innerHTML=list.length?list.map(function(p){
    return '<div class="card"><div class="pic">'+media(p)+'</div><div class="name">'+esc(p.name)+'</div><div class="desc">'+esc(p.desc)+'</div><div class="price">NT$ '+p.price+'</div><button onclick="add('+p.id+')">加入購物車</button></div>'}).join(""):'<p class="note">找不到商品，換個關鍵字試試～</p>';
}
function media(p){
  var v=p.video;
  if(!v)return esc(p.emoji);
  if(v.indexOf("/_blob/")===0){
    if(v.indexOf("#vid")>0)return '<video src="'+esc(v.split("#")[0])+'" controls playsinline preload="metadata" style="width:100%;border-radius:10px;font-size:0"></video>';
    return '<img src="'+esc(v.split("#")[0])+'" alt="'+esc(p.name)+'" loading="lazy" style="width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:10px;display:block">';
  }
  if(/^https?:\/\/\S+\.(jpg|jpeg|png|webp|gif)(\?.*)?$/i.test(v))return '<img src="'+esc(v)+'" alt="'+esc(p.name)+'" loading="lazy" style="width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:10px;display:block">';
  if(/^https?:\/\//.test(v))return esc(p.emoji)+'<br><a href="'+esc(v)+'" target="_blank" rel="noopener" style="font-size:14px;color:var(--accent)">▶ 看影片</a>';
  return esc(p.emoji);
}
function total(){var c=0,t=0;PRODUCTS.forEach(function(p){var q=cart[p.id]||0;c+=q;t+=q*p.price});return {c:c,t:t}}
function refresh(){var s=total();$("cnt").textContent=s.c;$("tot").textContent=fmt(s.t)}
function add(id){cart[id]=(cart[id]||0)+1;refresh()}
function chg(id,d){cart[id]=Math.max(0,(cart[id]||0)+d);refresh();openSheet()}
function closeSheet(){$("sheet").style.display="none"}
function openSheet(){
  var s=total();
  if(!s.c){$("panel").innerHTML='<p>購物車還是空的喔 🛒</p><button onclick="closeSheet()">繼續逛逛</button>';$("sheet").style.display="block";return}
  var rows=PRODUCTS.filter(function(p){return cart[p.id]}).map(function(p){
    return '<div class="row"><div>'+esc(p.emoji)+' '+esc(p.name)+'<br><span class="note">NT$ '+p.price+'</span></div><div class="qty"><button class="ghost" onclick="chg('+p.id+',-1)">−</button> '+cart[p.id]+' <button class="ghost" onclick="chg('+p.id+',1)">＋</button></div></div>'}).join("");
  $("panel").innerHTML='<h3 style="margin-top:0">我的購物車</h3>'+rows+
  '<p style="text-align:right">小計 <b>NT$ '+fmt(s.t)+'</b>（運費依實際為準）</p>'+
  '<label>姓名</label><input id="f_name">'+
  '<label>手機</label><input id="f_phone" type="tel">'+
  '<label>收件方式（超商店名或完整地址）</label><input id="f_addr">'+
  '<label>付款方式</label><div class="pay"><label><input type="radio" name="pay" value="貨到付款" checked>貨到付款</label><label><input type="radio" name="pay" value="轉帳">轉帳（確認訂單後提供帳號）</label></div>'+
  '<label>備註</label><textarea id="f_note" rows="2"></textarea>'+
  '<button style="width:100%" onclick="submitOrder()">產生訂單</button>'+
  '<button class="ghost" style="width:100%;margin-top:8px" onclick="closeSheet()">繼續逛逛</button>';
  $("sheet").style.display="block";
}
function submitOrder(){
  var n=$("f_name").value.trim(),ph=$("f_phone").value.trim(),ad=$("f_addr").value.trim(),nt=$("f_note").value.trim();
  var pay=document.querySelector('input[name=pay]:checked').value;
  if(!n||!ph||!ad){alert("請填寫姓名、手機和收件方式");return}
  var s=total();
  var lines=PRODUCTS.filter(function(p){return cart[p.id]}).map(function(p){return p.name+" x"+cart[p.id]+" = NT$"+(p.price*cart[p.id])});
  var text="【新訂單】\n"+lines.join("\n")+"\n商品合計：NT$"+s.t+"\n付款方式："+pay+"\n姓名："+n+"\n手機："+ph+"\n收件："+ad+(nt?"\n備註："+nt:"");
  window._orderText=text;
  $("panel").innerHTML='<h3 style="margin-top:0">訂單已產生 ✅</h3><p>請先複製訂單，再傳到官方LINE給我們確認：</p><pre id="otext"></pre>'+
  '<button style="width:100%" onclick="copyOrder()">① 複製訂單</button>'+
  '<a href="'+CONTACT_LINE_URL+'" target="_blank" rel="noopener"><button class="ghost" style="width:100%;margin-top:8px">② 前往官方LINE貼上傳送</button></a>'+
  '<a href="mailto:'+CONTACT_EMAIL+'?subject='+encodeURIComponent("新訂單")+'&body='+encodeURIComponent(text)+'"><button class="ghost" style="width:100%;margin-top:8px">或用 Email 寄出</button></a>'+
  '<p class="note">我們收到後會確認金額與出貨時間，謝謝！</p>';
  $("otext").textContent=text;
}
function copyOrder(){
  try{navigator.clipboard.writeText(window._orderText).then(function(){alert("已複製！")},function(){alert("請手動長按選取訂單文字")})}
  catch(e){alert("請手動長按選取訂單文字")}
}
// ===== 老闆專用：管理商品 =====
function adminEntry(){
  if(window._owner)openAdmin();
  else alert("管理功能只有老闆本人登入 Claude 後，從自己的網頁連結開啟才能使用");
}
function openAdmin(){
  $("panel").innerHTML='<h3 style="margin-top:0">管理商品（共 '+PRODUCTS.length+' 項）</h3>'+
  '<p class="note">每行一個商品，格式：<br><b>分類|商品名稱|價格|簡介|表情符號|圖片或影片(可不填)</b><br>新增就加一行，刪除就刪掉那一行，改價格直接改數字。</p>'+
  '<textarea id="adm" rows="12" style="font-size:13px"></textarea>'+
  '<div style="background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px;margin-bottom:12px"><b>🖼️ 上傳圖片／影片</b><p class="note" style="margin:4px 0">選好照片或影片（每個 20MB 內），上傳後網址會自動複製，貼到該商品那行最後面。也可以貼 IG／YouTube 連結（會顯示「看影片」按鈕）。</p><input type="file" id="vfile" accept="image/*,video/*" onchange="upVideo(this)"><div id="vmsg" class="note"></div></div>'+
  '<button style="width:100%" id="savebtn" onclick="saveAdmin()">儲存並發佈</button>'+
  '<button class="ghost" style="width:100%;margin-top:8px" onclick="closeSheet()">取消</button>';
  $("adm").value=$("data").textContent.trim();
  $("sheet").style.display="block";
}
async function upVideo(inp){
  var f=inp.files[0];if(!f)return;
  var m=$("vmsg");
  if(f.size>20*1024*1024){m.textContent="檔案超過 20MB，請先壓縮或剪短，或改貼連結";return}
  try{
    var as=await claude.use("assets");
    if(!as){m.textContent="目前無法上傳（需用老闆帳號開啟）";return}
    m.textContent="上傳中…";
    var r=await as.upload(f);
    var u2=r.url+((f.type||"").indexOf("video")===0?"#vid":"");
    try{await navigator.clipboard.writeText(u2)}catch(e){}
    m.innerHTML="✅ 上傳完成，網址：<br><b>"+esc(u2)+"</b><br>已嘗試複製，請貼到商品那行最後面（用 | 隔開）";
  }catch(e){m.textContent="上傳失敗，請稍後再試"}
}
async function saveAdmin(){
  var txt=$("adm").value.replace(/<\/script/gi,"").trim();
  if(!parse(txt).length){alert("商品清單不能是空的");return}
  try{
    var art=await claude.use("artifact");
    if(!art){alert("目前無法儲存");return}
    $("savebtn").textContent="發佈中…";
    var c=document.documentElement.cloneNode(true);
    c.querySelector("#data").textContent=txt;
    ["grid","chips","adminlink","panel"].forEach(function(i){c.querySelector("#"+i).innerHTML=""});
    c.querySelector("#sheet").style.display="none";
    c.querySelector("#search").removeAttribute("value");
    await art.publish("<!DOCTYPE html>\n"+c.outerHTML);
  }catch(e){alert("儲存失敗，請稍後再試");$("savebtn").textContent="儲存並發佈"}
}
$("sheet").addEventListener("click",function(e){if(e.target===$("sheet"))closeSheet()});
PRODUCTS=parse($("data").textContent);
renderChips();renderGrid();refresh();
</script>
</body>
</html>